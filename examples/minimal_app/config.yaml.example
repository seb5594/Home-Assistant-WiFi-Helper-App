name: WiFi Helper example
version: '0.1.0'
slug: wifi_example
arch: [amd64, aarch64]
startup: application
boot: manual_only
init: false
apparmor: true
map:
  - type: share
    read_only: false
privileged: [NET_ADMIN]
options:
  wifi_helper_host: 4c7fee11-wifi-helper
  interface: ''
schema:
  wifi_helper_host: str
  interface: str?
